*.tmp
*.temp
*.log
scratch/*
!scratch/.gitkeep
test_export_output*
test_save_project.veproj

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

